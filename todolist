locked queue_t event_queue;
PCIDevice g_dev; //note we assume that there's merely one device
void qemu_request_interrupt(void* offset,i64 reserved,i64 reserved,i64 reserved)
{
  unsigned long offset_v = (unsigned long)offset;
  event_queue.append_v(
    &offset_v,
    sizeof unsigned long
  );
}

