static unsigned long* consume_shared_v = 0;
//call once,called at IVshmemStateClass->realize
void consume_event() {
  while(1) {
    unsigned long data = event_queue.try_lend(0);
    if(!data)
      break;
    pci_set_irq(g_dev,g_dev,1);
    consume_shared_v = data;
    pci_set_irq(g_dev,g_dev,0); //make a pulse
    wait_client_writeback(); //这个的MMIO会自动帮我们写入
  }
}

