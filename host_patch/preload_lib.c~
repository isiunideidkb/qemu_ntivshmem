#include <unistd.h>
#include <stdio.h>
#include <dlfcn.h>
#include <sys/syscall.h>
#include <stdint.h>
#include <stdbool.h>
#include <pthread.h>
#include <stdatomic.h>
typedef void*(*cpmm_t)(uint64_t addr,uint64_t* plen,bool is_write);
void* test(void* func_addr)
{
    sleep(10); //等待qemu初始化 
    printf("running test \n");
    cpmm_t virt_map = (cpmm_t)func_addr;
    uint64_t length = 0x02000000;
    void * ret_virt_addr = virt_map((uint64_t)(0x00000000fa000000),&length,true);
    printf("called \n");
    if(ret_virt_addr == NULL) {
        printf("could not get the phys_addr\n");
	return NULL;
    }
    printf("OK i got the phys_addr %p",ret_virt_addr); //我们可以直接复用 因为我们是在QEMU的虚拟地址空间里面
    //write atomicly
    _Atomic int *flag = ret_virt_addr; //前4字节
    atomic_init(flag,114514);
    return NULL;
}


__attribute__((constructor))
void my_init(){
    printf("initializing .... \n");
    void* addr = dlsym(RTLD_DEFAULT,"cpu_physical_memory_map");
    if(addr == NULL){
        printf("[ERROR] could not be found");
	syscall(SYS_exit,-1);
    }
    printf("[INFO] fetched addr %p \n",addr);
    pthread_t t;
    pthread_create(&t, NULL, test, addr);
    pthread_detach(t);
    return;
}
